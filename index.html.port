    <section id="Sobre">
        <div class="container" <div class="sobre-mim">
            <img src="cool-fun.gif" class="foto-perfil" width="200px" <div class="sobre-informacoes">
            <h2><img src="imagem_transparente(1).png" width="20px" height="auto">Sobre Mim</h2>
            <p>Turma de desenvolvimento de sistemas - 2° Semestre - SESI</p>
        </div>
        </div>
        </div>
    </section>

    <section id="projetos">
        <div class="container">
            <h2><img src="imagem_transparente(1).png" width="20px" height="auto">Meus Projetos</h2>
            <div class="card">
                <h3>Aulas de LIMA</h3>
                <p>Aulas sobre HTML e CSS</p>
            </div>
            <div class="card">
                <h3>Shark Tank</h3>
                <p>Projeto Cérebro em Ação: Clubes escolares e atividades extracurriculares</p>
            </div>
            <div class="card">
                <h3>Juventudes em Dialogo</h3>
                <p>Projeto para ajudar os alunos caso precisem falar com a diretora</p>
            </div>
        </div>
        </div>
    </section>
    <section id="hobbies">
        <div class="container">
            <h2><img src="imagem_transparente(1).png" width="20px" height="auto">Meus Hobbies</h2>
            <div class="hobbies">
                <div class="hobby">
                    <i class="fa-solid fa-book"></i>
                    <h3>Leitura</h3>
                    <p>ler livros de suspense</p>
                </div>
                <div class="hobby">
                    <i class="fa-solid fa-gamepad"></i>
                    <h3>Jogar</h3>
                    <p>Jogar jogos eletrônicos</p>
                </div>
                <div class="hobby">
                    <i class="fa-solid fa-camera"></i>
                    <h3>Fotografia</h3>
                    <p>Tirar foto de momentos</p>
                </div>
            </div>
        </div>
    </section>
    <section id="Contato">
        <div class="container"></div>
        <h2>Contato</h2>
        <form>
            <label>Nome</label>
            <input type="text" id="nome" required>
            <br><br>
            <label>Email</label>
            <input type="email" id="email" required>
            <br><br>
            <label>Mensagem:</label>
            <textarea id="mensagem"></textarea>
            <button type="submit">Enviar</button>
        </form>
    </div>
    </section>
    <br>
    <br>
    <footer>
 <p>&copy;2026 Meu Portifólio</p>
